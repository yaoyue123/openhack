{
  "name": "openhack",
  "version": "0.0.1",
  "type": "module",
  "description": "AI-powered CTF agent with persistent memory, safety harness, and multi-agent architecture",
  "bin": {
    "openhack": "dist/index.js"
  },
  "files": [
    "dist/",
    "skills/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ctf",
    "security",
    "ai-agent",
    "llm",
    "capture-the-flag",
    "penetration-testing",
    "hacking",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaoyue123/openhack.git"
  },
  "homepage": "https://github.com/yaoyue123/openhack#readme",
  "bugs": {
    "url": "https://github.com/yaoyue123/openhack/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^6.0.185",
    "effect": "^3.21.2",
    "execa": "^9.6.1",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "ink": "^7.0.3",
    "minimatch": "^10.2.5",
    "react": "^19.2.6",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/yargs": "^17.0.35",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
