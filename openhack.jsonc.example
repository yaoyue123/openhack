{
  // LLM configuration (required)
  "llm": {
    // OpenAI-compatible API endpoint
    "baseURL": "https://api.siliconflow.cn/v1",
    // Model identifier
    "model": "deepseek-ai/DeepSeek-V4-Flash",
    // API key (or use OPENHACK_LLM_API_KEY env var)
    "apiKey": ""
  },

  // Agent behavior
  "agent": {
    // Maximum tool-calling iterations per solve
    "maxSteps": 25,
    // Timeout per challenge in seconds
    "timeout": 300
  },

  // Skills context injection
  "skills": {
    // Maximum bytes of companion skill files injected into prompt
    "maxCompanionBytes": 15000
  },

  // Permission policy
  "permissions": {
    "default": ["ask"],
    "rules": [
      { "tool": "read", "pattern": "*", "action": "allow" },
      { "tool": "glob", "pattern": "*", "action": "allow" },
      { "tool": "grep", "pattern": "*", "action": "allow" },
      { "tool": "write", "pattern": "*", "action": "allow" },
      { "tool": "bash", "pattern": "*", "action": "allow" }
    ]
  },

  // MCP servers (optional)
  "mcpServers": {},

  // Docker runtime (optional)
  "docker": {
    "enabled": true,
    "preferContainer": true
  }
}
